GUID::'7b452e82-52b0-4d37-ba80-2a47f028cf08' CREATE VIEW QRY_CLIENTES_COMPRA( CD_REGISTRO_NOMINA VARCHAR(10)  SET( "ui_mapping_text" = 'MRG_CLIENTES.CD_REGISTRO_NOMINA') ,
