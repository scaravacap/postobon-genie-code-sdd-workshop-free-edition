GUID::'9a11a29f-4f36-4ebb-80ba-01ae646ccf76' CREATE VIEW QRY_DROPSIZE( CD_PERIODO_MES VARCHAR(6)  SET( "ui_mapping_text" = 'substr($P_FECHA_FIN, 1, 6)') ,
 DT_CORTE VARCHAR(8)  SET( "ui_mapping_text" = '$P_FECHA_FIN') ,
 CD_PLANTA VARCHAR(4)  SET( "ui_mapping_text" = 'TT_TALLER_REGISTRO_NOMINA.CD_PLANTA') ,
 CD_REGISTRO_NOMINA VARCHAR(10)  SET( "ui_mapping_text" = 'TT_TALLER_REGISTRO_NOMINA.CD_REGISTRO_NOMINA') ,
 VL_VENTA_TOTAL DECIMAL(18, 2)  SET( "ui_mapping_text" = 'sum(QRY_VENTAS.VL_VENTA)') ,
 NM_PEDIDOS INT  SET( "ui_mapping_text" = '#count(QRY_VENTAS.NM_PEDIDO)
count_distinct(QRY_VENTAS.NM_PEDIDO)')  )
 AS
SELECT substr($P_FECHA_FIN, 1, 6), $P_FECHA_FIN, TT_TALLER_REGISTRO_NOMINA.CD_PLANTA, TT_TALLER_REGISTRO_NOMINA.CD_REGISTRO_NOMINA, sum(QRY_VENTAS.VL_VENTA), count_distinct(QRY_VENTAS.NM_PEDIDO) FROM QRY_VENTAS __SAP_INNER_JOIN TT_TALLER_REGISTRO_NOMINA  ON (QRY_VENTAS.CD_REGISTRO_NOMINA = TT_TALLER_REGISTRO_NOMINA.CD_REGISTRO_NOMINA)SET("ui_on_text" = 'QRY_VENTAS.CD_REGISTRO_NOMINA = TT_TALLER_REGISTRO_NOMINA.CD_REGISTRO_NOMINA')
 GROUP BY TT_TALLER_REGISTRO_NOMINA.CD_PLANTA, TT_TALLER_REGISTRO_NOMINA.CD_REGISTRO_NOMINA
SET("distinct_run_as_separate_process" = 'no', "group_by_run_as_separate_process" = 'no', "join_run_as_separate_process" = 'no', "order_by_run_as_separate_process" = 'no', "run_as_separate_process" = 'no')
;

