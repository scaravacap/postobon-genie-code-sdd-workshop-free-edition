GUID::'0a4fe639-e021-46a7-a9bb-e1352006b950' CREATE VIEW QRY_VENTAS( CD_REGISTRO_NOMINA VARCHAR(10)  SET( "ui_mapping_text" = 'TT_TALLER_PEDIDO_VENTA.CD_REGISTRO_NOMINA') ,
 CD_CLIENTE VARCHAR(10)  SET( "ui_mapping_text" = 'TT_TALLER_PORTAFOLIO.CD_CLIENTE') ,
 NM_PEDIDO VARCHAR(12)  SET( "ui_mapping_text" = 'TT_TALLER_PEDIDO_VENTA.NM_PEDIDO') ,
 VL_VENTA DECIMAL(18, 2)  SET( "ui_mapping_text" = 'TT_TALLER_PEDIDO_VENTA.VL_VENTA_NETA
#TT_TALLER_PEDIDO_VENTA.VL_VENTA_BRUTA')  )
 AS
SELECT TT_TALLER_PEDIDO_VENTA.CD_REGISTRO_NOMINA, TT_TALLER_PORTAFOLIO.CD_CLIENTE, TT_TALLER_PEDIDO_VENTA.NM_PEDIDO, TT_TALLER_PEDIDO_VENTA.VL_VENTA_NETA FROM TT_TALLER_PEDIDO_VENTA __SAP_INNER_JOIN TT_TALLER_PORTAFOLIO  ON (substr(TT_TALLER_PEDIDO_VENTA.DK_CLIENTE, 5, 10) = TT_TALLER_PORTAFOLIO.CD_CLIENTE)SET("ui_on_text" = 'substr(TT_TALLER_PEDIDO_VENTA.DK_CLIENTE, 5, 10) = TT_TALLER_PORTAFOLIO.CD_CLIENTE')
 WHERE ((TT_TALLER_PEDIDO_VENTA.CD_TIPO_DOCUMENTO = 'V') AND (TT_TALLER_PORTAFOLIO.DS_PORTAFOLIO IN ('OPT', 'EST')) AND (TT_TALLER_PORTAFOLIO.DS_CANAL like '%TRADICIONAL%'))
SET("distinct_run_as_separate_process" = 'no', "group_by_run_as_separate_process" = 'no', "join_run_as_separate_process" = 'no', "order_by_run_as_separate_process" = 'no', "run_as_separate_process" = 'no')
;

