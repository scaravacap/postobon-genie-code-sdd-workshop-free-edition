GUID::'d76e350b-4302-44a3-b9c5-9da3bb1f1580' CREATE VIEW QRY_VOLUMEN_DIA( CD_REGISTRO_NOMINA VARCHAR(10)  SET( "ui_mapping_text" = 'FCT_ROLLUP_VOLUMEN.CD_REGISTRO_NOMINA') ,
 CD_PLANTA VARCHAR(4)  SET( "ui_mapping_text" = 'FCT_ROLLUP_VOLUMEN.CD_PLANTA') ,
 CD_PRESENTACION VARCHAR(10)  SET( "ui_mapping_text" = 'DIM_PRODUCTO.CD_PRESENTACION') ,
 VL_FACTOR DECIMAL(10, 4)  SET( "ui_mapping_text" = 'nvl(TT_TALLER_FACTOR_CTV.VL_FACTOR, 0)') ,
 VL_VOLUMEN_CTV DECIMAL(18, 4)  SET( "ui_mapping_text" = '(FCT_ROLLUP_VOLUMEN.VL_VOLUMEN_ACUM * nvl(TT_TALLER_FACTOR_CTV.VL_FACTOR, 0))
#FCT_ROLLUP_VOLUMEN.VL_VOLUMEN_ACUM')  )
 AS
SELECT FCT_ROLLUP_VOLUMEN.CD_REGISTRO_NOMINA, FCT_ROLLUP_VOLUMEN.CD_PLANTA, DIM_PRODUCTO.CD_PRESENTACION, nvl(TT_TALLER_FACTOR_CTV.VL_FACTOR, 0), (FCT_ROLLUP_VOLUMEN.VL_VOLUMEN_ACUM * nvl(TT_TALLER_FACTOR_CTV.VL_FACTOR, 0)) FROM FCT_ROLLUP_VOLUMEN __SAP_INNER_JOIN DIM_PRODUCTO  ON (FCT_ROLLUP_VOLUMEN.CD_PRODUCTO = DIM_PRODUCTO.CD_PRODUCTO)SET("ui_on_text" = 'FCT_ROLLUP_VOLUMEN.CD_PRODUCTO = DIM_PRODUCTO.CD_PRODUCTO') __SAP_LEFT_OUTER_JOIN TT_TALLER_FACTOR_CTV  ON (DIM_PRODUCTO.CD_PRESENTACION = TT_TALLER_FACTOR_CTV.CD_PRESENTACION)SET("ui_on_text" = 'DIM_PRODUCTO.CD_PRESENTACION = TT_TALLER_FACTOR_CTV.CD_PRESENTACION')
 WHERE ((FCT_ROLLUP_VOLUMEN.SK_FECHA = $P_FECHA_ULT_HABIL) AND (FCT_ROLLUP_VOLUMEN.CD_REGISTRO_NOMINA NOT LIKE 'DUMMY%'))
SET("distinct_run_as_separate_process" = 'no', "group_by_run_as_separate_process" = 'no', "join_run_as_separate_process" = 'no', "order_by_run_as_separate_process" = 'no', "run_as_separate_process" = 'no')
;

