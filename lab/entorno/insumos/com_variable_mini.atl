GUID::'b8de3ec1-5a65-4704-942f-6d750e28f095' CREATE VIEW QRY_VOLUMEN_CTV( CD_PERIODO_MES VARCHAR(6)  SET( "ui_mapping_text" = 'substr($P_FECHA_FIN, 1, 6)') ,
 DT_CORTE VARCHAR(8)  SET( "ui_mapping_text" = '$P_FECHA_FIN') ,
 CD_PLANTA VARCHAR(4)  SET( "ui_mapping_text" = 'TT_TALLER_REGISTRO_NOMINA.CD_PLANTA') ,
 CD_REGISTRO_NOMINA VARCHAR(10)  SET( "ui_mapping_text" = 'TT_TALLER_REGISTRO_NOMINA.CD_REGISTRO_NOMINA') ,
 VL_VOLUMEN_CTV DECIMAL(18, 4)  SET( "ui_mapping_text" = 'sum(QRY_VOLUMEN_DIA.VL_VOLUMEN_CTV)')  )
 AS
SELECT substr($P_FECHA_FIN, 1, 6), $P_FECHA_FIN, TT_TALLER_REGISTRO_NOMINA.CD_PLANTA, TT_TALLER_REGISTRO_NOMINA.CD_REGISTRO_NOMINA, sum(QRY_VOLUMEN_DIA.VL_VOLUMEN_CTV) FROM QRY_VOLUMEN_DIA __SAP_INNER_JOIN TT_TALLER_REGISTRO_NOMINA  ON (QRY_VOLUMEN_DIA.CD_REGISTRO_NOMINA = TT_TALLER_REGISTRO_NOMINA.CD_REGISTRO_NOMINA)SET("ui_on_text" = 'QRY_VOLUMEN_DIA.CD_REGISTRO_NOMINA = TT_TALLER_REGISTRO_NOMINA.CD_REGISTRO_NOMINA')
 GROUP BY TT_TALLER_REGISTRO_NOMINA.CD_PLANTA, TT_TALLER_REGISTRO_NOMINA.CD_REGISTRO_NOMINA
SET("distinct_run_as_separate_process" = 'no', "group_by_run_as_separate_process" = 'no', "join_run_as_separate_process" = 'no', "order_by_run_as_separate_process" = 'no', "run_as_separate_process" = 'no')
;

