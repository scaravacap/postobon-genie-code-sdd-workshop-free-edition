#AND TT_TALLER_METAS_COBERTURA.CD_TIPO_META = \'MENSUAL\'', "x" = '777', "y" = '-237')
GUID::'87960e82-dbe4-4363-87b7-d714ce537822' CREATE VIEW QRY_COBERTURA( CD_PERIODO_MES VARCHAR(6)  SET( "ui_mapping_text" = 'substr($P_FECHA_FIN, 1, 6)') ,
 DT_CORTE VARCHAR(8)  SET( "ui_mapping_text" = '$P_FECHA_FIN') ,
 CD_PLANTA VARCHAR(4)  SET( "ui_mapping_text" = 'TT_TALLER_REGISTRO_NOMINA.CD_PLANTA') ,
 CD_REGISTRO_NOMINA VARCHAR(10)  SET( "ui_mapping_text" = 'TT_TALLER_REGISTRO_NOMINA.CD_REGISTRO_NOMINA') ,
 NM_CLIENTES_META INT  SET( "ui_mapping_text" = 'TT_TALLER_METAS_COBERTURA.NM_CLIENTES_META') ,
 NM_CLIENTES_COMPRA INT  SET( "ui_mapping_text" = 'nvl(QRY_CLIENTES_COMPRA.NM_CLIENTES_COMPRA, 0)') ,
 VL_COBERTURA DECIMAL(10, 4)  SET( "ui_mapping_text" = 'ifthenelse(TT_TALLER_METAS_COBERTURA.NM_CLIENTES_META = 0, 0, nvl(QRY_CLIENTES_COMPRA.NM_CLIENTES_COMPRA, 0) / TT_TALLER_METAS_COBERTURA.NM_CLIENTES_META)')  )
 AS
SELECT substr($P_FECHA_FIN, 1, 6), $P_FECHA_FIN, TT_TALLER_REGISTRO_NOMINA.CD_PLANTA, TT_TALLER_REGISTRO_NOMINA.CD_REGISTRO_NOMINA, TT_TALLER_METAS_COBERTURA.NM_CLIENTES_META, nvl(QRY_CLIENTES_COMPRA.NM_CLIENTES_COMPRA, 0), ifthenelse(TT_TALLER_METAS_COBERTURA.NM_CLIENTES_META = 0, 0, nvl(QRY_CLIENTES_COMPRA.NM_CLIENTES_COMPRA, 0) / TT_TALLER_METAS_COBERTURA.NM_CLIENTES_META) FROM TT_TALLER_REGISTRO_NOMINA __SAP_INNER_JOIN TT_TALLER_METAS_COBERTURA  ON (TT_TALLER_REGISTRO_NOMINA.CD_REGISTRO_NOMINA = TT_TALLER_METAS_COBERTURA.CD_REGISTRO_NOMINA)SET("ui_on_text" = 'TT_TALLER_REGISTRO_NOMINA.CD_REGISTRO_NOMINA = TT_TALLER_METAS_COBERTURA.CD_REGISTRO_NOMINA') __SAP_LEFT_OUTER_JOIN QRY_CLIENTES_COMPRA  ON (TT_TALLER_REGISTRO_NOMINA.CD_REGISTRO_NOMINA = QRY_CLIENTES_COMPRA.CD_REGISTRO_NOMINA)SET("ui_on_text" = 'TT_TALLER_REGISTRO_NOMINA.CD_REGISTRO_NOMINA = QRY_CLIENTES_COMPRA.CD_REGISTRO_NOMINA')
 WHERE ((TT_TALLER_METAS_COBERTURA.CD_PERIODO = substr($P_FECHA_FIN, 1, 6)))
SET("distinct_run_as_separate_process" = 'no', "group_by_run_as_separate_process" = 'no', "join_run_as_separate_process" = 'no', "order_by_run_as_separate_process" = 'no', "run_as_separate_process" = 'no')
;

