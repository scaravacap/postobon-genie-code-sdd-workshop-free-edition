AND to_char(to_date(AUTOVENTA.FECHA, \'YYYY-MM-DD\'), \'YYYYMMDD\') <= $P_FECHA_FIN', "x" = '729', "y" = '-314')
GUID::'0a10e78e-6d7b-4418-9966-b1139dd46126' CREATE VIEW QRY_AUTOVENTA( SK_FECHA VARCHAR(8)  SET( "ui_mapping_text" = 'to_char(to_date(AUTOVENTA.FECHA, \'YYYY-MM-DD\'), \'YYYYMMDD\')') ,
 CD_CLIENTE VARCHAR(10)  SET( "ui_mapping_text" = 'AUTOVENTA.CD_CLIENTE') ,
 CD_REGISTRO_NOMINA VARCHAR(10)  SET( "ui_mapping_text" = 'AUTOVENTA.CD_REGISTRO_NOMINA') ,
 CD_PLANTA VARCHAR(4)  SET( "ui_mapping_text" = 'AUTOVENTA.CD_PLANTA') ,
 VL_VENTA DECIMAL(18, 2)  SET( "ui_mapping_text" = 'AUTOVENTA.VL_VENTA')  )
 AS
SELECT to_char(to_date(AUTOVENTA.FECHA, 'YYYY-MM-DD'), 'YYYYMMDD'), AUTOVENTA.CD_CLIENTE, AUTOVENTA.CD_REGISTRO_NOMINA, AUTOVENTA.CD_PLANTA, AUTOVENTA.VL_VENTA FROM AUTOVENTA
 WHERE ((to_char(to_date(AUTOVENTA.FECHA, 'YYYY-MM-DD'), 'YYYYMMDD') >= $P_FECHA_INI) AND (to_char(to_date(AUTOVENTA.FECHA, 'YYYY-MM-DD'), 'YYYYMMDD') <= $P_FECHA_FIN))
SET("distinct_run_as_separate_process" = 'no', "group_by_run_as_separate_process" = 'no', "join_run_as_separate_process" = 'no', "order_by_run_as_separate_process" = 'no', "run_as_separate_process" = 'no')
;

