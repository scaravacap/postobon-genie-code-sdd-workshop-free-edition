 FL_SECUENCIA_DEVOLUCION VARCHAR(1)  SET( "ui_mapping_text" = 'DIM_FECHA.FL_SECUENCIA_DEVOLUCION') ,
 DT_NOVEDAD VARCHAR(8)  SET( "ui_mapping_text" = 'DIM_FECHA.DT_NOVEDAD') ,
 VL_CANAL DECIMAL(18, 2)  SET( "ui_mapping_text" = 'DIM_FECHA.VL_CANAL') ,
 CD_VISITA VARCHAR(10)  SET( "ui_mapping_text" = 'DIM_FECHA.CD_VISITA
#DIM_FECHA.CD_VISITA_ANT') ,
 NM_PEDIDO INT  SET( "ui_mapping_text" = 'DIM_FECHA.NM_PEDIDO') ,
 VL_VEHICULO_DEVOLUCION DECIMAL(18, 2)  SET( "ui_mapping_text" = 'nvl(DIM_FECHA.VL_VEHICULO_DEVOLUCION, 0)') ,
 DS_SUPERVISOR VARCHAR(60)  SET( "ui_mapping_text" = 'DIM_FECHA.DS_SUPERVISOR') ,
 NM_INVENTARIO INT  SET( "ui_mapping_text" = 'DIM_FECHA.NM_INVENTARIO') ,
 DS_CATEGORIA VARCHAR(60)  SET( "ui_mapping_text" = 'DIM_FECHA.DS_CATEGORIA')  )
 AS
SELECT ifthenelse(DIM_FECHA.FL_PRESUPUESTO_RECAUDO = 'S', 'S', 'N'), DIM_FECHA.CD_CUOTA, DIM_FECHA.CD_CLIENTE, DIM_FECHA.DS_CEDI_SABOR, upper(rtrim_blanks(DIM_FECHA.DS_CLIENTE)), DIM_FECHA.VL_ZONA, DIM_FECHA.NM_FRECUENCIA_META, DIM_FECHA.DT_ESTADO, nvl(DIM_FECHA.VL_PLANTA, 0), DIM_FECHA.NM_DEVOLUCION, ifthenelse(DIM_FECHA.FL_PEDIDO = 'S', 'S', 'N'), DIM_FECHA.CD_SUPERVISOR_FRECUENCIA, DIM_FECHA.DT_RECAUDO_PRESUPUESTO, DIM_FECHA.FL_SECUENCIA_DEVOLUCION, DIM_FECHA.DT_NOVEDAD, DIM_FECHA.VL_CANAL, DIM_FECHA.CD_VISITA, DIM_FECHA.NM_PEDIDO, nvl(DIM_FECHA.VL_VEHICULO_DEVOLUCION, 0), DIM_FECHA.DS_SUPERVISOR, DIM_FECHA.NM_INVENTARIO, DIM_FECHA.DS_CATEGORIA FROM DIM_FECHA
 WHERE ((DIM_FECHA.FL_PRESUPUESTO_RECAUDO IS NOT NULL))
SET("distinct_run_as_separate_process" = 'no', "group_by_run_as_separate_process" = 'no', "join_run_as_separate_process" = 'no', "order_by_run_as_separate_process" = 'no', "run_as_separate_process" = 'no')
;

