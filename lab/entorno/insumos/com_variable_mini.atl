 NM_PEDIDOS INT  SET( "ui_mapping_text" = 'QRY_DROPSIZE.NM_PEDIDOS') ,
 VL_DROPSIZE DECIMAL(18, 2)  SET( "ui_mapping_text" = 'ifthenelse(QRY_DROPSIZE.NM_PEDIDOS = 0, 0, QRY_DROPSIZE.VL_VENTA_TOTAL / QRY_DROPSIZE.NM_PEDIDOS)')  )
 AS
SELECT QRY_DROPSIZE.CD_PERIODO_MES, QRY_DROPSIZE.DT_CORTE, QRY_DROPSIZE.CD_PLANTA, QRY_DROPSIZE.CD_REGISTRO_NOMINA, QRY_DROPSIZE.VL_VENTA_TOTAL, QRY_DROPSIZE.NM_PEDIDOS, ifthenelse(QRY_DROPSIZE.NM_PEDIDOS = 0, 0, QRY_DROPSIZE.VL_VENTA_TOTAL / QRY_DROPSIZE.NM_PEDIDOS) FROM QRY_DROPSIZE
